{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    { "source": "/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }] }
  ],
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "header", "key": "accept-language", "value": "(?i)^\\s*ko.*" }],
      "missing": [
        { "type": "cookie", "key": "mu_lang" },
        { "type": "header", "key": "user-agent", "value": "(?i).*(bot|crawl|spider|slurp|yeti|daum|bing|google).*" }
      ],
      "destination": "/kr",
      "permanent": false
    },
    {
      "source": "/fitting-room",
      "has": [{ "type": "header", "key": "accept-language", "value": "(?i)^\\s*ko.*" }],
      "missing": [
        { "type": "cookie", "key": "mu_lang" },
        { "type": "header", "key": "user-agent", "value": "(?i).*(bot|crawl|spider|slurp|yeti|daum|bing|google).*" }
      ],
      "destination": "/kr",
      "permanent": false
    },
    { "source": "/", "destination": "https://matchup.fit/", "permanent": false },
    { "source": "/:path((?!kr$|kr/|robots\\.txt$).*)", "destination": "https://matchup.fit/:path", "permanent": false }
  ],
  "rewrites": [
    { "source": "/kr", "destination": "https://matchup-kr-staging.vercel.app/kr" },
    { "source": "/kr/:path*", "destination": "https://matchup-kr-staging.vercel.app/kr/:path*" }
  ]
}
